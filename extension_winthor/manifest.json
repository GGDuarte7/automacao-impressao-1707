{
  "manifest_version": 3,
  "name": "WinThor Keep AutoSync",
  "version": "5.1",
  "description": "Sincroniza notas do Google Keep com o servidor local do WinThor",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://keep.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://keep.google.com/*"],
      "js": ["content.js"]
    }
  ]
}